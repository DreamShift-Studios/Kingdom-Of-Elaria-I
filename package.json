{
  "name": "kingdom-of-elaria-nightmare",
  "productName": "Kingdom of Elaria",
  "version": "1.3.0",
  "description": "Kingdom of Elaria: Rise Against Velymoor - Visual Challenge Update",
  "author": "DreamShift Team",
  "main": "electron-main.js",
  "private": true,
  "license": "All Rights Reserved",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "build": {
    "appId": "com.dreamshiftstudios.kingdomofelaria",
    "productName": "Kingdom of Elaria",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "style.css",
      "js/**/*",
      "electron-main.js",
      "package.json",
      "README.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kingdom of Elaria"
    }
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  }
}
